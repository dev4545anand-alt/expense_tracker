}

#=======================expense======
#api call for listing expense
###
GET http://127.0.0.1:8000/expense/
Accept: application/json
Authorization: Basic django@:password@123


#api call for adding expense
###
Post http://127.0.0.1:8000/expense/
Content-Type: application/json
Authorization: Basic django@:password@123

{
    "title":"lunch",
    "amount":"300",
    "category":"food"
}

#api call for retrieve expense
###
GET http://127.0.0.1:8000/expense/1/
Accept: application/json
Authorization: Basic react:password@123

#api call for update expense
###
PUT http://127.0.0.1:8000/expense/1/
Content-Type:  application/json
Authorization: Basic react:password@123

{
    
    "id": 1,
    "title": "snacks",
    "category": "food",
    "amount": "400.00",
    "description": null,
    "payment_method": "upi",
    "bill_image": null,
    "created_at": "2026-11-12T06:01:03.669897Z",
    "owner": 2
}

#api call for delete expense
###
delete http://127.0.0.1:8000/expense/2/
Accept:  application/json
Authorization: Basic react:password@123